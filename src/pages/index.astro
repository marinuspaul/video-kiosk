---
import Default from "../layouts/Default.astro";
import FilmCover from "../components/FilmCover.astro";
import { getCollection, getEntry } from "astro:content";

const films = await getCollection("films");
const parsedFilms = films.map((film) => ({
  filmID: film.slug,
  title: film.data.title,
  author: film.data.author,
  sectionID: film.data?.sectionID,
}));

const sections = await getCollection("sections");

const parsedContent = sections.map((section) => ({
  data: section.data,
  films: parsedFilms.filter((film) => film.sectionID == section.data.id),
}));
// console.log(parsedContent);

const menuInfo = await getEntry("ui", "menu-ui");
// console.log(menuInfo);
---

<Default title={menuInfo.data.title}>
  <main>
    <div class="head">
      <h3 class="subtitle">{menuInfo.data.subtitle}</h3>
      <h1 class="main-title">{menuInfo.data.title}</h1>
    </div>
    {
      parsedContent.map((section) => (
        <div class="film-section">
          <div class="section-head">
            <h2 class="section-title">{section.data.title}</h2>
            <h3 class="subtitle">{section.data.subtitle}</h3>
          </div>
          <div class="film-grid">
            <a class="film-poster" href={`/watch/index.html`} />
          </div>
        </div>
      ))
    }
  </main>
  <script type="text/javascript" src="./data.js"></script>

  <script>
    const posterTemplate = document.querySelector(
      ".film-poster"
    ) as HTMLSourceElement;
    console.log(posterTemplate);
    const sectionElement = document.querySelector(
      ".film-section"
    ) as HTMLSourceElement;

    data.forEach((film) => {
      console.log(film);
      const posterElement = posterTemplate.cloneNode() as HTMLElement;
      // posterElement.style.backgroundImage = `url(../../public/posters/${film.file}.jpg)`; // DEV
      posterElement.style.backgroundImage = `url(./posters/${film.file}.jpg)`; // BUILD
      posterElement.setAttribute("data-file", film.file);
      posterElement.setAttribute("data-title", film.title);
      posterElement.setAttribute("data-author", film.author);
      posterElement.onmousedown = (event) => {
        localStorage.setItem("file", posterElement.getAttribute("data-file"));
        localStorage.setItem("title", posterElement.getAttribute("data-title"));
        localStorage.setItem(
          "author",
          posterElement.getAttribute("data-author")
        );
      };
      sectionElement.querySelector(".film-grid").appendChild(posterElement);
    });
    posterTemplate.remove();
  </script>

  <style>
    main {
      margin: auto;
      padding: 1rem;
      width: 70vw;

      color: white;
      font-size: 20px;
      line-height: 1.6;
      margin-bottom: 10rem;
    }

    .head {
      margin-top: 9rem;
    }

    h1 {
      margin: -0.5rem 0 2rem 0;
    }

    .film-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
      gap: 2rem;
      padding: 0;
    }

    .section-head {
      margin-top: 8rem;
      margin-bottom: 3rem;
    }

    .section-title {
      font-size: 3.5rem;
      margin: 0;
      margin-top: -0.5rem;
      margin-bottom: -0.8rem;
    }

    .subtitle {
      margin: 0;
      color: var(--accent-color);
      font-variant: small-caps;
      text-transform: lowercase;
      font-weight: 500;
      letter-spacing: 0.1em;
    }

    .film-section {
      width: 100%;
    }

    .main-title {
      font-size: 5rem;
      margin-top: -1rem;
    }

    .film-poster {
      display: block;
      width: 100%;
      aspect-ratio: 1/ 1.4;
      background-color: grey;
      background-size: cover;
      background-position: 50%;
      place-self: center;
      border-radius: 3px;
      border: 1px rgba(255, 255, 255, 0.1) solid;
      transition: all ease-out 0.2s;
    }

    .film-poster:hover {
      transform: scale(1.05);
    }
  </style>
</Default>
