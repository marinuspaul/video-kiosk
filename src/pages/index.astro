---
import Default from "../layouts/Default.astro";
import FilmCover from "../components/FilmCover.astro";
import { getCollection, getEntry } from "astro:content";

// console.log(parsedContent);

const menuInfo = await getEntry("ui", "menu-ui");
// console.log(menuInfo);
---

<Default title={menuInfo.data.title}>
  <main>
    <div class="head">
      <h3 class="main-subtitle subtitle">Welcome</h3>
      <h1 class="main-title">Video Kiosk</h1>
    </div>
    <div class="film-section">
      <div class="section-head">
        <h2 class="section-title">Section Title</h2>
        <h3 class="subtitle">Subtitle</h3>
      </div>
      <div class="film-grid">
        <a class="film-poster" href={`/watch/index.html`}></a>
      </div>
    </div>
  </main>

  <script>
    const mainElement = document.querySelector("main") as HTMLSourceElement;
    const posterTemplate = document.querySelector(
      ".film-poster"
    ) as HTMLSourceElement;
    const sectionTemplate = document.querySelector(
      ".film-section"
    ) as HTMLSourceElement;

    let sections = {};

    let counter = 0;
    fetch("./data.json")
      .then((response) => response.json())
      .then((data) => {
        data.films.forEach((film) => {
          const posterElement = posterTemplate.cloneNode() as HTMLElement;
          counter++;
          console.log(counter + " " + film.title);
          posterElement.style.backgroundImage = `url(./posters/${film.file}.png)`;
          posterElement.setAttribute("data-file", film.file);
          posterElement.setAttribute("data-title", film.title);
          posterElement.setAttribute("data-author", film.author);
          const sectionExists = sections[film.section] != undefined;
          if (!sectionExists) {
            const newSectionElement = sectionTemplate.cloneNode(
              true
            ) as HTMLElement;
            sections[film.section] = {
              title: film.section,
              subtitle: "blabla",
              element: newSectionElement,
            };
            (
              newSectionElement.querySelector(".section-title") as HTMLElement
            ).innerText = data.sections[film.section].title;
            (
              newSectionElement.querySelector(".subtitle") as HTMLElement
            ).innerText = data.sections[film.section].subtitle;
            mainElement.appendChild(sections[film.section].element);
          }
          posterElement.onmousedown = (event) => {
            localStorage.setItem(
              "file",
              posterElement.getAttribute("data-file")
            );
            localStorage.setItem(
              "title",
              posterElement.getAttribute("data-title")
            );
            localStorage.setItem(
              "author",
              posterElement.getAttribute("data-author")
            );
          };
          const sectionElement = sections[film.section].element;
          sectionElement.querySelector(".film-grid").appendChild(posterElement);
        });

        const mainTitleElement = document.querySelector(
          ".main-title"
        ) as HTMLElement;
        const mainSubtitleElement = document.querySelector(
          ".main-subtitle"
        ) as HTMLElement;

        mainTitleElement.innerText = data.general.title;
        mainSubtitleElement.innerText = data.general.subtitle;
      });

    console.log(sections);
    sectionTemplate.remove();
    posterTemplate.remove();
  </script>

  <style>
    main {
      margin: auto;
      padding: 1rem;
      width: 70vw;

      color: white;
      font-size: 20px;
      line-height: 1.6;
      margin-bottom: 10rem;
    }

    .head {
      margin-top: 9rem;
    }

    h1 {
      margin: -0.5rem 0 2rem 0;
    }

    .film-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
      gap: 2rem;
      padding: 0;
    }

    .section-head {
      margin-top: 8rem;
      margin-bottom: 3rem;
    }

    .section-title {
      font-size: 3.5rem;
      margin: 0;
      margin-top: -0.5rem;
      margin-bottom: -0.8rem;
    }

    .subtitle {
      margin: 0;
      color: var(--accent-color);
      font-variant: small-caps;
      text-transform: lowercase;
      font-weight: 500;
      letter-spacing: 0.1em;
    }

    .film-section {
      width: 100%;
    }

    .main-title {
      font-size: 5rem;
      margin-top: -1rem;
    }

    .film-poster {
      display: block;
      width: 100%;
      aspect-ratio: 1/ 1.4;
      background-color: grey;
      background-size: cover;
      background-position: 50%;
      place-self: center;
      border-radius: 3px;
      border: 1px rgba(255, 255, 255, 0.1) solid;
      transition: all ease-out 0.2s;
    }

    .film-poster:hover {
      transform: scale(1.05);
    }
  </style>
</Default>
